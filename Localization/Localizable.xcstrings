    "Đường truyền tốt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link is good."
          }
        }
      }
    },
    "Wi‑Fi chập chờn: SRT đang gửi lại gói, hình vẫn đủ.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi‑Fi is unsteady: SRT is resending packets, the picture is still complete."
          }
        }
      }
    },
    "Gói đến quá trễ bị bỏ → hình giật. Tăng độ trễ Wi‑Fi (Cài đặt › Kết nối), dùng Wi‑Fi 5 GHz, đặt máy gần router hoặc giảm bitrate trên DTDLive.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Packets arrive too late and are dropped → stutter. Raise the Wi‑Fi latency (Settings › Connections), use 5 GHz Wi‑Fi, move closer to the router or lower the bitrate in DTDLive."
          }
        }
      }
    },
    "Độ trễ Wi‑Fi DTDLive %@ ms": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DTDLive Wi‑Fi latency %@ ms"
          }
        }
      }
    },
    "Cao hơn = chịu được Wi‑Fi chập chờn (SRT kịp gửi lại gói) nhưng hình trễ hơn. 300 ms cho Wi‑Fi tốt, 500–800 ms cho Wi‑Fi đông. Áp dụng sau khi mở lại app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher = tolerates unsteady Wi‑Fi (SRT has time to resend) but more delay. 300 ms for good Wi‑Fi, 500–800 ms for busy Wi‑Fi. Applies after reopening the app."
          }
        }
      }
    },
    "Bitrate thích ứng: giảm %@ → %@ kbps (mạng tải lên chậm, trễ %@ s)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptive bitrate: down %@ → %@ kbps (slow upload, %@ s behind)"
          }
        }
      }
    },
    "Bitrate thích ứng: tăng lại %@ → %@ kbps (trễ %@ s)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptive bitrate: back up %@ → %@ kbps (%@ s behind)"
          }
        }
      }
    },
    "Máy nóng: giảm bitrate còn %@ kbps": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device hot: bitrate lowered to %@ kbps"
          }
        }
      }
    },
    "Máy đã nguội: trả lại bitrate đầy đủ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device cooled: full bitrate restored"
          }
        }
      }
    },
    "Khuyến nghị cho %@×%@ %@ fps: %@ Mbps": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommended for %@×%@ %@ fps: %@ Mbps"
          }
        }
      }
    },
    "Dùng mức này": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this"
          }
        }
      }
    },
    "Bitrate thấp so với độ phân giải → hình trên YouTube/Facebook sẽ mờ, nhất là cảnh chuyển động.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitrate is low for this resolution → the picture on YouTube/Facebook will look soft, especially in motion."
          }
        }
      }
    },
    "Bật: mạng chậm thì tự giảm bitrate (hình mềm hơn nhưng không đứng). Tắt: giữ nét, mạng chậm thì bỏ khung hình.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: lowers bitrate when the network is slow (softer but no freezing). Off: stays sharp, drops frames when the network is slow."
          }
        }
      }
    },
    "Dùng SuperFG làm hiệu ứng chuyển cảnh (CUT / AUTO / T-bar)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use SuperFG as the transition (CUT / AUTO / T-bar)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng SuperFG làm hiệu ứng chuyển cảnh (CUT / AUTO / T-bar)"
          }
        }
      }
    },
    "Tối ưu chất lượng tốt nhất cho các đích phát": {
      "localizations": {
