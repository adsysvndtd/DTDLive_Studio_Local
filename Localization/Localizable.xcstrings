    },
    "Lặp lại từ ngày bắt đầu trở đi, cùng giờ.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeats from the start date onward, at the same time."
          }
        }
      }
    },
    "Lặp lại: danh sách chạy mãi cho đến khi khung giờ sau lên PVW và anh chuyển cảnh, hoặc bấm Dừng.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop: the list keeps playing until the next slot is on PVW and you transition, or you press Stop."
          }
        }
      }
    },
